# Firebase Configuration
# Keep this on one line. For Docker --env-file, do not wrap it in quotes and do
# not add an inline comment on the same line.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id",...}

# Database Configuration
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# Server Configuration
PORT=5050
FRONTEND_URL=https://your-production-url.com
API_URL=http://localhost:5050
FRONTEND_URL_DEV=http://localhost:5173
NODE_ENV=development

# Dev-only: when true, backend skips Firebase token verification and allows dashboard access without login
FIREBASE_BYPASS_AUTH=false
